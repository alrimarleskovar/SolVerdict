{
  "name": "@solverdict/sak-adapter",
  "version": "0.2.0",
  "description": "Run any Solana Agent Kit agent through the SolVerdict scenarios on your own machine.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx test/capture.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "//pins": "ai + @ai-sdk/anthropic are EXACT-pinned to the versions the SolVerdict benchmark uses (root package.json) \u2014 the adapter must drive SAK identically to how the benchmark drives it, since that is what SolVerdict measures. solana-agent-kit and @solana/web3.js are peers so the adapter operates on the SAME instances/classes as the developer's agent.",
  "dependencies": {
    "@ai-sdk/anthropic": "1.2.12",
    "ai": "4.3.19"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.4",
    "solana-agent-kit": "2.0.10"
  },
  "devDependencies": {
    "@solana/web3.js": "1.98.4",
    "@types/node": "24.10.1",
    "solana-agent-kit": "2.0.10",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "keywords": [
    "solana",
    "solana-agent-kit",
    "solverdict",
    "ai-agent",
    "safety",
    "audit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrimarleskovar/SolVerdict.git",
    "directory": "packages/sak-adapter"
  }
}
